@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirmación de registro";

    Layout = "_LayoutGestor";
}

<h1>@ViewData["Title"]</h1>
@{
    if (@Model.DisplayConfirmAccountLink)
    {
        <p>
            Los registros de usuarios hechos en el usuario gestor recibiran un correo electrónico
            de confirmación, pero también puede hacer la confirmación de correo haciendo
            clic aquí: <a id="confirm-link" href="@Model.EmailConfirmationUrl">Confirmar correo</a>
        </p>
    }
    else
    {
        <p>
            Por favor revise su correo electrónico para confirmar su cuenta.
        </p>
    }
}

