@page
@using Preacepta.UI.Areas.Identity.Pages.Account
@model ExpirationPasswordModel
@{
    ViewData["Title"] = "Expiración de contraseña";
    Layout = "_LayoutLysoIdentiy";
}

<div class="page-title-area page-title-area-three title-img-one">
    <div class="d-table">
        <div class="d-table-cell">
            <div class="page-title-text">
                <h2>Modulo de autenticación</h2>
                <ul>
                    <li>
                        <a asp-action="Index">Página de inicio</a>
                    </li>
                    <li>
                        <i class="icofont-simple-right"></i>
                    </li>
                    <li>
                        <a asp-area="Identity" asp-page="/Account/Login">Credenciales</a>
                    </li>
                    <li>
                        <i class="icofont-simple-right"></i>
                    </li>
                    <li>Expiración de contraseña</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<br />
<br />

<div class="contact-form contact-form-two contact-form-three" style="padding-left:20%; padding-right:20%">
    <div class="container">
        <div class="contact-wrap">
            <h2>@ViewData["Title"]</h2>

            <div class="row">

                <form id="change-password-form" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="form-floating mb-3">
                        <div class="form-group">
                            <label asp-for="Input.OldPassword" class="form-label"></label>
                            <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Por favor, introduzca su contraseña actual." />

                            <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-floating mb-3">
                        <div class="form-group">
                            <label asp-for="Input.NewPassword" class="form-label"></label>
                            <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Por favor, introduzca su nueva contraseña." />

                            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-floating mb-3">
                        <div class="form-group">
                            <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Por favor confirme su nueva contraseña." />

                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-floating mb-3">
                        <div class="form-group">
                            <label asp-for="Input.periodo" class="form-label"></label>
                            <div class="form-check">
                                <input asp-for="Input.periodo" value="30" class="form-check-input" type="radio" id="flexRadioDefault1" >
                                <label class="form-check-label" for="flexRadioDefault1">
                                    30 dias
                                </label>
                            </div>
                            <div class="form-check">
                                <input asp-for="Input.periodo" value="60" class="form-check-input" type="radio" id="flexRadioDefault2">
                                <label class="form-check-label" for="flexRadioDefault2">
                                    60 dias
                                </label>
                            </div>
                            <div class="form-check">
                                <input asp-for="Input.periodo" value="90" class="form-check-input" type="radio" id="flexRadioDefault3" checked>
                                <label class="form-check-label" for="flexRadioDefault2">
                                    90 dias
                                </label>
                            </div>
                            <span asp-validation-for="Input.periodo" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <button type="submit" class=" w-100 contact-btn--primario btn-lg">Actualizar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@if (TempData["ExpirationPassword"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Swal.fire({
                title: 'Sistema de autenticación',
                text: '@TempData["ExpirationPassword"]',
                icon: 'information',
                confirmButtonText: 'Continuar',
                customClass: {
                    confirmButton: 'contact-btn--primario' // Clase CSS personalizada
                }
            });
        });
    </script>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
