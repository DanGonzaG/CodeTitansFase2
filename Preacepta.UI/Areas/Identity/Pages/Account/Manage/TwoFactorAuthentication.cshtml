@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Autenticación de dos factores (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h2>@ViewData["Title"]</h2>
@{
    var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();
    @if (consentFeature?.CanTrack ?? true)
    {
        @if (Model.Is2faEnabled)
        {
            if (Model.RecoveryCodesLeft == 0)
            {
                <div class="alert alert-danger">
                    <strong>No le quedan códigos de recuperación.</strong>
                    <p>Usted debe <a asp-page="./GenerateRecoveryCodes">generar un nuevo conjunto de códigos de recuperación</a> antes de poder iniciar sesión con un código de recuperación.</p>
                </div>
            }
            else if (Model.RecoveryCodesLeft == 1)
            {
                <div class="alert alert-danger">
                    <strong>Le queda 1 código de recuperación.</strong>
                    <p>Usted puede <a asp-page="./GenerateRecoveryCodes">generar un nuevo conjunto de códigos de recuperación</a>.</p>
                </div>
            }
            else if (Model.RecoveryCodesLeft <= 3)
            {
                <div class="alert alert-warning">
                    <strong>Usted tiene @Model.RecoveryCodesLeft quedan códigos de recuperación.</strong>
                    <p>Debería <a asp-page="./GenerateRecoveryCodes">generar un nuevo conjunto de códigos de recuperación</a>.</p>
                </div>
            }
            if (Model.IsMachineRemembered)
            {
                <form method="post" style="display: inline-block">
                    <button type="submit" class="contact-btn--primario">Olvídar de este navegador</button>
                </form>
            }

            <div class="row justify-content-center">
                <div class="col-auto">
                    <div class="row m-1 w-100">
                        <a asp-page="./Disable2fa" class="contact-btn--primario">Desactivar doble factor de autenticación</a>
                    </div>
                    <div class="row m-1 w-100">
                        <a asp-page="./GenerateRecoveryCodes" class="contact-btn--primario">Restablecer códigos de recuperación</a>

                    </div>

                </div>
            </div>


        }

        <br />
        <br />

        <h2>Aplicación de autenticación</h2>
        @if (!Model.HasAuthenticator)
        {
            <div class="row justify-content-center">
                <div class="col">
                    <div class="row m-1 w-100">
                        <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="contact-btn--primario">Agregar aplicación de autenticación</a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="row justify-content-center">
                <div class="col-auto">
                    <div class="row m-1 w-100">
                        <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="contact-btn--primario">Configurar la aplicación de autenticación</a>
                    </div>
                    <div class="row m-1 w-100">
                        <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="contact-btn--primario">Restablecer la aplicación de autenticación</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-danger">
            <strong>No se han aceptado la política de privacidad y cookies.</strong>
            <p>Debe aceptar la política antes de poder habilitar la autenticación de dos factores.</p>
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
