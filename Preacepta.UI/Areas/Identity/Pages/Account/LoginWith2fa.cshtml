@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Autenticación de dos factores";
    Layout = "_LayoutLysoIdentiy";
}


<div class="page-title-area page-title-area-three title-img-one">
    <div class="d-table">
        <div class="d-table-cell">
            <div class="page-title-text">
                <h2>Modulo de autenticación</h2>
                <ul>
                    <li>
                        <a asp-action="Index">Página de inicio</a>
                    </li>
                    <li>
                        <i class="icofont-simple-right"></i>
                    </li>
                    <li>
                        <a asp-area="Identity" asp-page="/Account/Login">Credenciales</a>
                    </li>
                    <li>
                        <i class="icofont-simple-right"></i>
                    </li>
                    <li>Autencación</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<br />
<br />

<div class="contact-form contact-form-two contact-form-three" style="padding-left:20%; padding-right:20%">
    <div class="container">
        <div class="contact-wrap">


            <h2>@ViewData["Title"]</h2>
            <hr />
            <div class="row">
                <div class="col">
                    <p class="LetraNegra">Su inicio de sesión está protegido con una aplicación de autenticación. Ingresa tu código de autenticación a continuación.</p>

                </div>
            </div>
            <div class="row">
                <div class="col LetraNegra">
                    <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                        <input asp-for="RememberMe" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                        <!--<div class="form-floating mb-3">-->
                        <div class="form-group">
                            <label asp-for="Input.TwoFactorCode" class="form-label"></label>
                            <input asp-for="Input.TwoFactorCode" class="form-control" autocomplete="off" />
                            <span asp-validation-for="Input.TwoFactorCode" class="text-danger"></span>
                        </div>
                        <div class="checkbox mb-3">
                            <label asp-for="Input.RememberMachine" class="form-label">
                                <input asp-for="Input.RememberMachine" />
                                @Html.DisplayNameFor(m => m.Input.RememberMachine)
                            </label>
                        </div>
                        <input type="hidden" asp-for="ValidarPassword" /> 
                        <div>
                            <button type="submit" class="w-100 btn-lg contact-btn--primario">Iniciar sesión</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="row">
                <div class="col">
                    <p class="LetraNegra">
                        ¿No tienes acceso a tu dispositivo autenticador? Puedes
                        <a id="recovery-code-login" asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl">iniciar sesión con un código de recuperación</a>.
                    </p>
                </div>
            </div>




        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}