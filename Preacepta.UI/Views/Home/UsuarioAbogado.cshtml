<script>
    document.addEventListener('DOMContentLoaded', function () {

        document.getElementById('doc1').addEventListener('click', function (event) {
            event.preventDefault();
            Swal.fire({
                title: 'Ingrese las cédulas',
                html:
                    `<input id="CedulaImputado" class="swal2-input" placeholder="Cédula del Imputado">
                <input id="CedulaAsistente" class="swal2-input" placeholder="Cédula del Asistente Legal">`,
                showCancelButton: true,
                confirmButtonText: 'Continuar',
                icon: 'question',
                customClass: {
                    cancelButton: 'contact-btn--tercero',
                    confirmButton: 'contact-btn--secundario'
                },
                preConfirm: () => {
                    const CedulaImputado = document.getElementById('CedulaImputado').value.trim();
                    const CedulaAsistente = document.getElementById('CedulaAsistente').value.trim();
                    if (!CedulaImputado || !CedulaAsistente) {
                        Swal.showValidationMessage('Debe ingresar ambas cédulas');
                        return false;
                    }
                    return { CedulaImputado, CedulaAsistente };
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    // Validar ambos en el servidor
                    Promise.all([
                        fetch('/Personas/IdExiste?id=' + result.value.CedulaImputado).then(r => r.json()),
                        fetch('/Personas/IdExiste?id=' + result.value.CedulaAsistente).then(r => r.json())
                    ]).then(([resImputado, resAsistente]) => {
                        if (resImputado.bandera && resAsistente.bandera) {
                            // Ambos existen, redirigir
                            window.location.href = `/DocsAutorizacionRevisionExpedientes/CreateDocsAutorizacionRevisionExpedientes?CedulaImputado=${result.value.CedulaImputado}&CedulaAsistente=${result.value.CedulaAsistente}`;
                        } else {
                            let msg = "";
                            if (!resImputado.bandera && !resAsistente.bandera) {
                                msg = "Ninguna de las cédulas está registrada.";
                            } else if (!resImputado.bandera) {
                                msg = "La cédula del imputado no está registrada.";
                            } else {
                                msg = "La cédula del asistente no está registrada.";
                            }
                            Swal.fire('Sistema de búsqueda', msg, 'error');
                        }
                    });
                }
            });
        });

