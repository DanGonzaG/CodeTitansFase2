@model Preacepta.Modelos.AbstraccionesFrond.TTestimonioDTO

<!-- IMPORTA TUS CSS -->
<head>
    <link href="~/lyso/css/Daniel.css" rel="stylesheet" />
    <link href="~/lyso/css/Testimonials.css" rel="stylesheet" />
</head>

<div class="page-title-area page-title-area-two title-img-one">
    <div class="d-table">
        <div class="d-table-cell">
            <div class="page-title-text">
                <h2>Su testimonio</h2>
                <ul>
                    <li>
                        <a href="index.html">Página de inicio</a>
                    </li>
                    <li>
                        <i class="icofont-simple-right"></i>
                    </li>
                    <li>Su testimonio</li>
                </ul>
                <!-- ¡AQUÍ VA el título de agradecimiento! -->
                <h2 class="titulo-agradecimiento">
                    Agradecemos su visita. Sus comentarios son valiosos para nosotros.
                </h2>
            </div>
        </div>
    </div>
</div>

<div class="contact-form contact-form-four pb-100">
    <div class="container-fluid">
        <form asp-action="TestimonialForm" method="post" id="contactForm">
            <div class="row contact-wrap">
                <div class="col-sm-6 col-lg-6">
                    <div class="form-group">
                        <input type="hidden" asp-for="IdCliente" value="@ViewBag.IdCliente" />
                    </div>
                </div>

                <!-- Caja de comentario grande -->
                <div class="col-md-12 col-lg-12">
                    <div class="form-group">
                        <label asp-for="Comentario" class="control-label"></label>
                        <textarea asp-for="Comentario" class="form-control textarea-comentario" id="Comentario" required></textarea>
                        <span asp-validation-for="Comentario" class="text-danger"></span>
                    </div>
                </div>

                <!-- Estrellas de calificación -->
                <div class="clasificacion">
                    <label style="position:relative">
                        <input type="radio" name="Evaluacion" value="1" required>
                        <span class="star">★</span>
                    </label>
                    <label style="position:relative">
                        <input type="radio" name="Evaluacion" value="2">
                        <span class="star">★</span>
                    </label>
                    <label style="position:relative">
                        <input type="radio" name="Evaluacion" value="3">
                        <span class="star">★</span>
                    </label>
                    <label style="position:relative">
                        <input type="radio" name="Evaluacion" value="4">
                        <span class="star">★</span>
                    </label>
                    <label style="position:relative">
                        <input type="radio" name="Evaluacion" value="5">
                        <span class="star">★</span>
                    </label>
                </div>

                <!-- Checkbox de términos -->
                <div class="form-group">
                    <div class="form-check agree-label">
                        <input name="gridCheck"
                               class="form-check-input"
                               type="checkbox"
                               id="gridCheck"
                               required>
                        <label class="form-check-label" for="gridCheck">
                            Acepta <a href="terms-condition.html">Términos y Condiciones</a> & <a href="privacy-policy.html">Política de privacidad.</a>
                        </label>
                        <div class="help-block with-errors gridCheck-error"></div>
                    </div>
                </div>

                <!-- Botón de enviar centrado -->
                <div class="col-md-12 col-lg-12 btn-centro">
                    <button type="submit" class="contact-btn--primario">Enviar</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Validación de campos y estrellas
        document.getElementById('contactForm').addEventListener('submit', function (e) {
            var comentario = document.getElementById('Comentario').value.trim();
            var evaluacion = document.querySelector('input[name="Evaluacion"]:checked');
            var terminos = document.getElementById('gridCheck').checked;
            let valido = true;
            let mensajes = [];

            if (!comentario) {
                mensajes.push("Debe ingresar un comentario.");
                valido = false;
            }
            if (!evaluacion) {
                mensajes.push("Debe seleccionar una calificación.");
                valido = false;
            }
            if (!terminos) {
                mensajes.push("Debe aceptar los términos y condiciones.");
                valido = false;
            }

            if (!valido) {
                e.preventDefault();
                alert(mensajes.join('\n'));
            }
        });

        // Efecto visual en las estrellas
        document.querySelectorAll('input[name="Evaluacion"]').forEach((radio, i, radios) => {
            radio.addEventListener('change', function () {
                radios.forEach((r, idx) => {
                    if (idx <= i) {
                        r.nextElementSibling.style.color = '#ffc107';
                    } else {
                        r.nextElementSibling.style.color = '#ccc';
                    }
                });
            });
        });
    </script>
}
