@model List<Preacepta.Modelos.AbstraccionesFrond.DocumentosCitaDTO>

<script src="https://cdnjs.cloudflare.com/ajax/libs/forge/1.3.1/forge.min.js"></script>

<div id="modalListarDocumentos" class="custom-modal" style="display:none;">
    <div class="custom-modal-content contact-form contact-form-two LetraNegra">


        <h4 style="text-align: center; margin-bottom: 3rem;">
            Documentos compartidos en esta cita
            </h4>

        @if (Model.Any())
        {
            <ul>
                @foreach (var doc in Model)
                {
                    var inputId = $"chkPermitir_{doc.Id}";
                    <li data-id="@doc.Id" class="documento-item">
                        <div class="switch-container">
                            <label class="switch">
                                <input type="checkbox" class="chk-permitir"
                                       data-id="@doc.Id" @(doc.Descargar ? "checked" : "") />
                                <span class="slider"></span>
                            </label>
                        </div>

                        <div class="documento-info">
                            <strong>@doc.NombreArchivo</strong>
                            <span class="estado @(doc.Descargar ? "text-success-light" : "text-danger")">
                                @(doc.Descargar ? "Descarga Autorizada" : "Descarga sin Autorización")
                            </span>

                            <button onclick="procesoCompletoDescifrado(@doc.Id)" class="contact-btn--primario btn-descargar">Descargar</button>

                            <span class="fecha text-muted">(subido el @doc.FechaSubida.ToShortDateString())</span>
                        </div>

                       
                        <div class="switch-container">
                            <label class="switch">
                                <input type="checkbox" class="chk-activo"
                                       data-id="@doc.Id" @(doc.Activo ? "checked" : "") />
                                <span class="slider-activo"></span>
                            </label>
                            <span class="estado-activo text-muted">@((doc.Activo) ? "Habilitado" : "Deshabilitado")</span>
                        </div>

                    </li>
                }
            </ul>

            <button id="btnActualizarTodos" type="button" style="margin-top:1rem;" class="contact-btn--primario">
                Actualizar
            </button>
        }
        else
        {
            <p id="mensajeSinDocumentos" style="display:none;">No hay documentos aún.</p>

        }
        <hr />

        <h5>Subir nuevo documento</h5>
        <form id="formSubirDocumento"
              enctype="multipart/form-data"
              data-id-cita="@ViewBag.IdCita"
              action="/SubirCifrado">
            <!--<div class="fila-archivo">
                <label for="archivo" class="contact-btn--navegacion">Seleccionar archivo</label>
                <span id="nombreArchivo" class="nombreArchivo"></span>
            </div>-->

            <input type="file" id="archivo" name="ArchivoCifrado" accept=".pdf,.docx,.jpg,.png"/>


            <input type="hidden" id="publicKeyPem" value="@ViewBag.PublicKeyPem" />
            <input type="hidden" id="OwnerId" value="@ViewBag.UsuarioId" />
            <input type="hidden" id="IdCita" value="@ViewBag.IdCita" />


            <div style="margin-top: 1.5rem; text-align: center;">
                <button type="button"
                        id="btnSubirDocumentoCifrado"
                        class="contact-btn--primario">
                    Subir Documento
                </button>
            </div>
        </form>
        <div style="margin-top:1rem; text-align:center;">
            <button onclick="cerrarModalListarDocumentos()" class="contact-btn--navegacion">Cerrar</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/idb@7/build/umd.js"></script>
    <script src="~/lyso/js/CifradoDocs.js"></script>
    <script src="~/calendario/scriptcalendar.js"></script>
    <script src="~/lyso/js/Calendar-init.js"></script>
    <link href="~/lyso/css/Daniel.css" rel="stylesheet" />

}


<script>
    document.addEventListener('click', async (e) => {
        const modal = document.getElementById('modalListarDocumentos');
        if (!modal) return;

        // Botón de subir documento
        if (e.target && e.target.id === "btnSubirDocumentoCifrado") {
            e.preventDefault();
            await subirDocumentoCifrado();
        }
    });

</script>
<script src="/js/crypto-e2ee.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", async () => {
        if (window.inicializarClavePrivadaUsuario) {
            await inicializarClavePrivadaUsuario();
        }
    });
</script>
<script>
document.getElementById("archivo").addEventListener("change", function () {
    const span = document.getElementById("nombreArchivo");
    span.textContent = this.files.length > 0 ? this.files[0].name : "";
});
</script>