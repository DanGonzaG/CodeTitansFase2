@model Preacepta.Modelos.AbstraccionesFrond.CitasDTO

@{
    ViewData["Title"] = "Eliminar Cita";
    Layout = "_LayoutGestor";
}

<h1>Eliminar Cita</h1>
<hr />

<div class="alert alert-warning">
    <p>¿Está seguro de que desea eliminar la siguiente cita?</p>
</div>

<dl class="row">
    <dt class="col-sm-4">ID</dt>
    <dd class="col-sm-8">@Model.IdCita</dd>

    <dt class="col-sm-4">Fecha</dt>
    <dd class="col-sm-8">@Model.Fecha.ToShortDateString()</dd>

    <dt class="col-sm-4">Hora</dt>
    <dd class="col-sm-8">@Model.Hora</dd>

    <dt class="col-sm-4">Tipo de Cita</dt>
    <dd class="col-sm-8">@(Model.NombreTipoCita ?? Model.IdTipoCita.ToString())</dd>

    <dt class="col-sm-4">Anfitrión</dt>
    <dd class="col-sm-8">@(Model.NombreAnfitrion ?? Model.Anfitrion.ToString())</dd>
</dl>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="IdCita" />
    <div class="mt-3">
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-info">Cancelar</a>
    </div>
</form>
