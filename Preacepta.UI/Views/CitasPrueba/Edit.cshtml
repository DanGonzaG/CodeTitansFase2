@model Preacepta.Modelos.AbstraccionesFrond.CitasDTO

@{
    ViewData["Title"] = "Editar Cita";
    Layout = "_LayoutGestor";
}

<h1>Editar Cita</h1>
<hr />

<form asp-action="Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="IdCita" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Fecha" class="form-label"></label>
        <input asp-for="Fecha" type="date" class="form-control" />
        <span asp-validation-for="Fecha" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Hora" class="form-label"></label>
        <input asp-for="Hora" type="time" class="form-control" />
        <span asp-validation-for="Hora" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="IdTipoCita" class="form-label">Tipo de Cita</label>
        <select asp-for="IdTipoCita" class="form-select" asp-items="ViewBag.TipoCitaList" disabled></select>
        <input type="hidden" asp-for="IdTipoCita" />

        <span asp-validation-for="IdTipoCita" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NombreAnfitrion" class="form-label">Anfitrión</label>
        <input asp-for="NombreAnfitrion" class="form-control" readonly />
        <input type="hidden" asp-for="Anfitrion" />
    </div>

    <div class="form-group mb-3">
        <label class="form-label">Enlace de reunión</label>
        @if (!string.IsNullOrWhiteSpace(Model.LinkVideo))
        {
            <p><a href="@Model.LinkVideo" target="_blank">@Model.LinkVideo</a></p>
        }
        else
        {
            <input type="text" class="form-control" value="Aún no asignado" readonly />
        }
    </div>

    <div class="form-group mb-3">
        <label class="control-label">Cliente</label>
        @if (Model.NombresClientes != null && Model.NombresClientes.Any())
        {
            <input type="text" class="form-control" value="@Model.NombresClientes.First()" readonly />
            <input type="hidden" asp-for="IdCliente" />
        }
        else
        {
            <input type="text" class="form-control" value="No asignado" readonly />
        }
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-warning">Guardar</button>
        <a asp-action="Index" class="btn btn-info">Cancelar</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
