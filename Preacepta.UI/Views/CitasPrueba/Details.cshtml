@model Preacepta.Modelos.AbstraccionesFrond.CitasDTO

@{
    ViewData["Title"] = "Detalles de la Cita";
    Layout = "_LayoutGestor";
}

<h1>Detalles de la Cita</h1>
<hr />

<dl class="row">
    <dt class="col-sm-4">ID</dt>
    <dd class="col-sm-8">@Model.IdCita</dd>

    <dt class="col-sm-4">Fecha</dt>
    <dd class="col-sm-8">@Model.Fecha.ToShortDateString()</dd>

    <dt class="col-sm-4">Hora</dt>
    <dd class="col-sm-8">@Model.Hora</dd>

    <dt class="col-sm-4">Tipo de Cita (ID)</dt>
    <dd class="col-sm-8">@Model.IdTipoCita</dd>

    <dt class="col-sm-4">Nombre Tipo Cita</dt>
    <dd class="col-sm-8">@(Model.NombreTipoCita ?? Model.IdTipoCita.ToString())</dd>

    <dt class="col-sm-4">Anfitrión</dt>
    <dd class="col-sm-8">
            @if (!string.IsNullOrWhiteSpace(Model.NombreAnfitrion))
            {
                @($"{Model.NombreAnfitrion} ({Model.Anfitrion})")
            }
            else
            {
                @Model.Anfitrion
            }
        </dd>

    <dt class="col-sm-4">Link de Video</dt>
    <dd class="col-sm-8">
        @if (!string.IsNullOrWhiteSpace(Model.LinkVideo))
        {
            <a href="@Model.LinkVideo" target="_blank">@Model.LinkVideo</a>
        }
        else
        {
            <span>No asignado</span>
        }
    </dd>
    <dt class="col-sm-4">Cliente</dt>
    <dd class="col-sm-8">
        @if (Model.NombresClientes != null && Model.NombresClientes.Any())
        {
            @Model.NombresClientes.First()
        }
        else
        {
            <span>No asignado</span>
        }
    </dd>
    <dd class="col-sm-8">
        @{
            string estadoTexto;
            switch (Model.Estado)
            {
                case 0: estadoTexto = "En proceso"; break;
                case 1: estadoTexto = "Terminada"; break;
                case 2: estadoTexto = "Cancelada por cliente"; break;
                case 3: estadoTexto = "Cancelada por Abogado"; break;
                case 4: estadoTexto = "Reprogramada"; break;
                default: estadoTexto = "Desconocido"; break;
            }
        }
        @estadoTexto
    </dd>
</dl>

<div class="mt-3">
    
    <a asp-action="Index" class="btn btn-info">Regresar</a>
</div>
