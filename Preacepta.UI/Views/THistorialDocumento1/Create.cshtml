@model Preacepta.Modelos.AbstraccionesBD.THistorialDocumento

@{
    ViewData["Title"] = "Create";
    Layout = "_LayoutGestor";
}

<h1>Create</h1>

<h4>THistorialDocumento</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Cliente" class="control-label"></label>
                <select asp-for="Cliente" class ="form-control" asp-items="ViewBag.Cliente"></select>
            </div>
