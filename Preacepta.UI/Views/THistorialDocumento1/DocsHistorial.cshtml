@model IEnumerable<Preacepta.Modelos.AbstraccionesFrond.HistorialDocumentoDTO>




<head>
    <link href="~/lyso/css/Andy.css" rel="stylesheet" />
    <link href="~/lyso/css/Daniel.css" rel="stylesheet" />
</head>

<!-- Page Title -->
<div class="page-title-area page-title-area-two title-img-one">
    <div class="d-table">
        <div class="d-table-cell">
            <div class="page-title-text">
                <h2>Historial de documentos legales</h2>
                <ul>
                    <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li><i class="icofont-simple-right"></i></li>
                    <li><a asp-controller="Home" asp-action="UsuarioAutenticado" asp-route-correo="@User.Identity.Name">PreaceptaApp</a></li>
                    <li><i class="icofont-simple-right"></i></li>
                    <li>Historial documentos</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<br />
<br />
<br />

<div class="contact-form contact-form-two contact-form-three">
    <div class="container">
        <div class="contact-wrap">
            <h2 class="text-center">Filtrar el listado de documentos</h2>

            <div class="row justify-content-center">
                <!-- Fecha -->
                <div class="col-sm-4 col-md-3 filtro-campo">
                    <div class="form-group">
                        <label for="fecha">Fecha</label>
                        <input id="inputFechaHistorial" type="date" name="fecha" class="form-control" value="@(ViewContext.HttpContext.Request.Query["fecha"])" />
                    </div>
                </div>

                <!-- Tipo de documento -->
                <div class="col-sm-4 col-md-4 filtro-campo">
                    <div class="form-group">
                        <label for="tipo">Tipo de documento</label>
                        <select id="selectTipoDocumento" name="tipo" class="form-control" asp-items="ViewBag.TipoDocumento">
                            <option value="">-- Todos los tipos --</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col text-center">
                    <button id="botonBuscarHistorial" class="boton-buscar">Buscar</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="formulario contact-form contact-form-two contact-form-three LetraNegra">
    <div class="container">
        <table class="table">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Fecha)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.TipoDocumento)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IdDocumento)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Titulo)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ClienteNavigation)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.AbogadoNavigation)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Fecha)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.TipoDocumento)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.IdDocumento)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Titulo)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ClienteNavigation.NumCedula)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.AbogadoNavigation.CedulaNavigation.NumCedula)
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                            <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                            <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>


                            <a class="cmn-btn"
                               asp-controller="THistorialDocumento1"
                               asp-action="PrevisualizarDesdeHistorial"
                               asp-route-id="@item.Id"
                               target="_blank">
                                <i class="fa-solid fa-eye"></i>
                            </a>

                            <a class="cmn-btn"
                               asp-controller="THistorialDocumento1"
                               asp-action="EditarDesdeHistorial"
                               asp-route-id="@item.Id">
                                <i class="fa-solid fa-pen"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="~/lyso/js/configuraciontablas.js"></script>
<script src="~/lyso/js/fltradoHistorialDocs.js"></script>

